{
  "expo": {
    "name": "Welyto",
    "slug": "welyto",
    "scheme": "welyto",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alvarovillalbaa.welyto",
      "buildNumber": "1",
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.alvarovillalbaa.welyto",
      "versionCode": 1,
      "adaptiveIcon": { "foregroundImage": "./assets/adaptive-icon.png", "backgroundColor": "#F6F3EA" },
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.CAMERA", "android.permission.READ_MEDIA_IMAGES", "android.permission.READ_MEDIA_VIDEO"]
    },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/favicon.png", "name": "Welyto — a little closer, every week" },
    "plugins": [["expo-image-picker", { "photosPermission": "Choose a photo to add to your family's private memories.", "cameraPermission": false, "microphonePermission": false }]]
  }
}
